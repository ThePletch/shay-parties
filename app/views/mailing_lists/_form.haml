= bootstrap_form_with(model: mailing_list) do |f|
  - if mailing_list.errors.any?
    #error_explanation
      %h2= t("mailing_list.form.errors_msg", count: mailing_list.errors.count)
      %ul
        - mailing_list.errors.full_messages.each do |message|
          %li= message
  = f.text_field :name, floating: true
  .actions
    = f.submit (mailing_list.persisted? ? t("mailing_list.form.save") : t("mailing_list.form.create")), class: "btn btn-primary"
