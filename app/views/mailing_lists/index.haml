- title t("mailing_list.index.title")
.d-flex.justify-content-between.align-items-center.mb-3
  %h1.title.mb-0= t("mailing_list.index.header")
  = link_to t("mailing_list.index.new_button"), new_mailing_list_path, class: "btn btn-primary"
- if @mailing_lists.any?
  - @mailing_lists.each do |mailing_list|
    .d-flex.justify-content-between.align-items-center.gap-3.border-bottom.py-3
      %div
        = link_to mailing_list.name, mailing_list, class: "fw-medium fs-5 text-decoration-none"
        .text-muted.small= t("mailing_list.address_count", count: mailing_list.emails.size)
      = render "menu", mailing_list: mailing_list
- else
  %p= t("mailing_list.index.empty")
