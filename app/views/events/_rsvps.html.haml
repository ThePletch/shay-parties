- going = rsvps_order(event.attendances.going)
- maybe = rsvps_order(event.attendances.maybe)
- not_going = rsvps_order(event.attendances.not_going)

%section.attendees
  %p.going-count.fw-medium.mb-1= t('event.show.going_count', count: going.size)
  - if going.empty?
    %p.text-muted.small= t('event.rsvp_list.empty_category')
  - else
    %ul.attendee-list.going-list
      = render partial: 'attendances/attendance', collection: going
  - if maybe.any? || not_going.any?
    %details.other-rsvps
      %summary.small.link-secondary.text-decoration-underline.link-underline-opacity-0.link-underline-opacity-100-hover= t('event.show.other_rsvps', maybe: maybe.size, cant: not_going.size)
      - if maybe.any?
        %p.small.fw-medium.mt-2.mb-1= t('event.show.rsvp.maybe')
        %ul.attendee-list
          = render partial: 'attendances/attendance', collection: maybe
      - if not_going.any?
        %p.small.fw-medium.mt-2.mb-1= t('event.show.rsvp.cant')
        %ul.attendee-list
          = render partial: 'attendances/attendance', collection: not_going
