= vite_typescript_tag 'entrypoints/events/show'
- title @event.title

= content_for :edge_to_edge do
  .hero
    .hero-image
      = event_header_image_tag(@event)

.event-show
  .d-flex.justify-content-between.align-items-start.gap-3.mt-3
    %h1.h2.mb-1= @event.title
    - if @event.owned_by?(current_user)
      = render 'events/manage', event: @event
  - if @event.requires_testing
    %p.testing-requirement
      %span.badge.text-bg-danger= t('event.show.testing_badge')
      %small= t('event.show.requires_testing')
  .event-when.mt-2
    - if @event.single_day?
      .fw-medium= l(@event.start_time, format: :day)
      = EventTime.same_day_range(@event)
    - else
      %span.fw-medium= l(@event.start_time, format: :day)
      = l(@event.start_time, format: :clock)
      %span.d-block
        = "…#{t('event.show.time_separator')}"
        %span.fw-medium= l(@event.end_time, format: :day)
        = l(@event.end_time, format: :clock)
  - if @event.address
    .mt-1= render 'addresses/show', address: @event.address
  %p.text-muted.fst-italic.small.mb-3
    - if @event.owned_by?(current_user)
      = t('event.show.hosted_by_you')
    - else
      = t('event.show.hosted_by_other', name: @event.owner.name)

  = render 'attendances/event_form', attendance: @attendance, event: @event, attendee: @attendee
  = render 'events/calendar_links', attendee: @attendee, event: @event

  .content.my-4= Markdown.html(@event.description)

  = render 'events/rsvps', event: @event

  - if @event.polls.any?
    .polls.my-4
      - @event.polls.each do |poll|
        = render 'polls/poll', poll: poll, respondent: @attendee

  .comments.mt-4
    = render @event.root_comments, comments: @event.comments
    - if @authenticated_user
      %a.comment-button.link-secondary.link-underline-opacity-0.link-underline-opacity-100-hover{data: {id: 'new'}}= t('comment.actions.new')
      .comment-form{data: {id: 'new'}}
        = render 'comments/form', event: @event
