= vite_typescript_tag 'entrypoints/events/form'

- address = event.address
- location_line = [address&.first_line, address&.second_line].compact_blank.join(", ")
- location_open = address&.errors&.any?

.event-form
  %h1.h2.mb-3
    - if event.persisted?
      = t('event.form.title.edit', title: event.title)
    - else
      = t('event.form.title.new')
  = bootstrap_form_for(event, url: event.persisted? ? event_path(event) : events_path) do |form|
    = form.text_field :title, floating: true
    = form.form_group(class: 'd-flex flex-column flex-sm-row align-items-sm-end gap-sm-2') do
      .flex-sm-grow-1
        = form.text_field :start_time, class: 'datetimepicker', value: event.start_time, floating: true
      %span.text-muted.pb-sm-3= t('event.form.time_separator')
      .flex-sm-grow-1
        = form.text_field :end_time, class: 'datetimepicker', value: event.end_time, floating: true

    .mb-3
      .form-label= t('event.form.location')
      #event-location-summary{hidden: location_open}
        #event-location-filled{hidden: location_line.blank?}
          .d-flex.align-items-center.justify-content-between.gap-3
            %p#event-location-line.mb-0= location_line
            %button#event-location-change.btn.btn-link.px-0{type: 'button'}= t('event.form.change_location')
        %button#event-location-add.btn.btn-link.px-0{type: 'button', hidden: location_line.present?}= t('event.form.add_location')
      #event-location-editor{hidden: !location_open}
        = render partial: "addresses/form", locals: { parent_form: form, address: event.address }
        %button#event-location-done.btn.btn-link.px-0{type: 'button'}= t('event.form.location_done')

    = form.text_area :description, rows: 5, floating: true, help: t('event.form.description_uses_markdown_html', link: link_to(t('event.form.description_uses_markdown_name'), 'https://www.markdownguide.org/basic-syntax/'))

    .mb-3
      = form.hidden_field :photo_crop_y_offset
      - if event.photo.attached?
        = form.hidden_field :photo, value: form.object.photo.signed_id
      = form.file_field :photo, direct_upload: true, hide_label: true, class: 'visually-hidden', wrapper_class: 'mb-0'
      %label#event-photo-add.btn.btn-link.px-0{for: 'event_photo', hidden: event.photo.attached?}= t('event.form.add_header_photo')
      #event-photo-chosen{hidden: !event.photo.attached?}
        .d-flex.gap-3.align-items-center
          %img#event-photo-thumb.event-photo-thumb{alt: '', src: event.photo.attached? ? rails_storage_redirect_path(event.photo) : nil}
          %div
            #event-photo-name.small
              - if event.photo.attached?
                = event.photo.filename
            .d-flex.gap-3
              %label.btn.btn-link.px-0.py-0{for: 'event_photo'}= t('event.form.replace_header_photo')
              %button#event-photo-crop-toggle.btn.btn-link.px-0.py-0{type: 'button', aria: {expanded: 'false', controls: 'event-photo-crop'}, data: {show_label: t('event.form.adjust_crop'), hide_label: t('event.form.hide_crop')}}= t('event.form.adjust_crop')
      #event-photo-crop.mt-2{hidden: true}
        .event-photo-frame
          %img#photo-preview{alt: t('event.form.header_photo_crop_prompt'), src: event.photo.attached? ? rails_storage_redirect_path(event.photo) : nil, data: {initial_y_offset: event.photo_crop_y_offset}}
        %p.form-text.mb-0= t('event.form.header_photo_crop_prompt')

    = form.select :plus_one_max, [[t('event.form.plus_ones_none'), 0], 1, 2, 3, [t('event.form.plus_ones_unlimited'), -1]], {label: t('event.form.plus_ones_label'), selected: event.plus_one_max.nil? ? -1 : event.plus_one_max, floating: true, wrapper_class: 'event-plus-ones'}
    = form.check_box :requires_testing
    %p#event-testing-help.form-text{hidden: !event.requires_testing}= t('event.form.testing_help')

    .mb-3
      = dynamic_list t('poll.add_prompt'), form, :polls, {partial: 'polls/form', layout: :inline}, class: 'btn btn-link px-0' do
        = form.fields_for(:polls, layout: :inline) do |f|
          = render partial: "polls/form", locals: {f: f}

    .actions
      = form.primary
      = link_to t('back'), hosted_events_path, class: 'ms-2 btn btn-light'
