:ruby
  # Views that use this partial must supply the following variables:
  # comment - the comment to be rendered
  # comments - nested comment tree created by event.comment_tree

.card.comment.m-2{id: "comment-#{comment.id}"}
  .card-body{class: (comment.deleted? && 'text-muted em')}
    %strong.author= comment.creator.name
    %small
      %span.timestamp
        = l(comment.created_at, format: :full)
      %span.timestamp
        - if comment.deleted?
          - deletion_title = comment.editor == comment.creator ? "" : t('comment.view.deleted_by', editor: comment.editor.try(:name))
          %strong{title: deletion_title, data: {toggle: 'tooltip', placement: 'right'}}= t('comment.view.deleted')
        - elsif comment.edited?
          %span{title: l(comment.updated_at, format: :full), data: {toggle: 'tooltip', placement: 'right'}} ✏️
    - unless comment.deleted?
      %span.avatar.float-start.mt-2.me-3.mb-1
        = image_tag(Gravatar.url(comment.creator.email), alt: comment.creator.name, title: comment.creator.name, border: 1)
    - if comment.deleted?
      - if comment.deletable_by?(@authenticated_user)
        .comment-actions
          = button_to t("comment.actions.undelete"), undelete_comment_path(comment, guest_guid: params[:guest_guid]), method: :put, class: "undelete-button btn btn-sm btn-danger", form: { class: "d-inline" }, remote: false
    - else
      .comment-body.body{id: "comment-#{comment.id}-body"}
        = Markdown.html(comment.body)
      - if comment.editable_by?(@authenticated_user)
        .edit-form{id: "comment-#{comment.id}-edit"}
          = render 'comments/form', comment: comment
    - if @authenticated_user and !comment.deleted?
      .reply-form{data: {id: comment.id}}
        = render 'comments/form', parent_comment: comment
      .comment-actions
        %a.btn.btn-sm.btn-link.link-secondary.link-underline-opacity-0.link-underline-opacity-100-hover.p-0.reply-button{data: {id: comment.id}}= t('comment.actions.reply')
        .comment-action-group
          - if comment.editable_by?(@authenticated_user)
            %a.edit-button.btn.btn-sm.btn-link.link-secondary.link-underline-opacity-0.link-underline-opacity-100-hover.p-0{id: "comment-#{comment.id}-edit-button", data: {id: comment.id}}= t('comment.actions.edit')
          - if comment.deletable_by?(@authenticated_user)
            = button_to t("comment.actions.delete"), comment_path(comment, guest_guid: params[:guest_guid]), method: :delete, class: "btn btn-sm btn-link link-danger link-underline-opacity-0 link-underline-opacity-100-hover p-0 delete-button", form: confirm_form(t("comment.actions.confirm_delete")), remote: false
    .clearfix
    .section.bottom
    .children
      = render children_from(comment, comments), comments: comments
