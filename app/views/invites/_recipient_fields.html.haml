.row.g-2.mb-2{data: { controller: "dynamic-list-record" }}
  .col-md-5
    = text_field_tag "recipients[#{index}][name]", recipient[:name], class: "form-control", placeholder: t("invite.form.name_placeholder"), id: "recipients_#{index}_name"
  .col-md-6
    = email_field_tag "recipients[#{index}][email]", recipient[:email], class: "form-control", placeholder: t("invite.form.email_placeholder"), id: "recipients_#{index}_email"
  .col-md-1
    = dynamic_list_record_delete_button
