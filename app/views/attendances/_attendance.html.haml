- plus_one = attendance.attendance_id.present?
- name = attendance.attendee == current_user ? t('event.show.you') : attendance.attendee.name
%li.attendee-row{class: ('attendee-plus-one' if plus_one)}
  = image_tag(Gravatar.url(attendance.attendee.email, size: 25), class: 'avatar rounded-circle', alt: '', size: '25x25')
  %span.attendee-name= name
  - if plus_one && attendance.parent_attendance&.attendee
    %small.text-muted.with-attendee= t('event.show.with_attendee', name: attendance.parent_attendance.attendee.name)
  - if attendance.event.owned_by?(current_user)
    = button_to t('event.show.remove'), attendance_path(attendance), method: :delete, class: 'btn btn-sm btn-link link-danger link-underline-opacity-0 link-underline-opacity-100-hover p-0 remove-attendance', form: confirm_form(t('attendance.dialog.remove_attendance', name: attendance.attendee.name), class: 'd-inline ms-auto')
