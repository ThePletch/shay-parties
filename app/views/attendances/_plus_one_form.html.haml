= f.form_group layout: :inline, class: 'row', data: {controller: 'dynamic-list-record'} do
  = dynamic_list_record_hidden_fields(f)
  = f.hidden_field :event_id, value: event.id
  .input-group
    .input-group-text{class: ('text-bg-danger' if f.object.errors.any?)}
      %span.me-2= "+1"
    = f.fields_for :attendee, f.object.attendee || Guest.new do |f_attendee|
      = f_attendee.hidden_field :id, value: f_attendee.object.try(:id) unless f.object.new_record?
      = f_attendee.text_field :name, value: f_attendee.object.try(:name), floating: true
      = f_attendee.text_field :email, value: f_attendee.object.try(:email), floating: true
    = dynamic_list_record_delete_button
  - if f.object.errors.any?
    .form-text= f.errors_on(:base, custom_class: 'text-danger')
