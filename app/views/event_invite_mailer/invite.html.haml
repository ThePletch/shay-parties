%p= t('.greeting', name: @recipient_name.presence || t('.friend'))
- if @message.present?
  .host-message= simple_format(ERB::Util.html_escape(@message))
%p
  %a{href: @event_url, style: "display:inline-block;padding:12px 20px;background:#0d6efd;color:#ffffff;text-decoration:none;border-radius:4px;"}= t('.cta', title: @event.title)
%p
  %a{href: @event_url}= @event_url
