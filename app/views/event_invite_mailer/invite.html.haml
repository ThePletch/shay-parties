%p{style: "font-size:13px;color:#6c757d;margin-top:0;"}= t(".header", title: @event.title)
- if @message.present?
  %p= t(".note", name: @host.name)
  .host-message= simple_format(ERB::Util.html_escape(@message))
%p
  %a{href: @event_url, style: "display:inline-block;padding:12px 20px;background:#0d6efd;color:#ffffff;text-decoration:none;border-radius:4px;"}= t(".cta")
%p
  = t(".link_fallback")
  %br
  %a{href: @event_url}= @event_url
