.poll
  %h5.poll-question
    = poll.question
  - if respondent.nil?
    %em.text-muted.small= t('poll.rejection.unauthenticated_html', sign_in_link: link_to(t('poll.rejection.unauthenticated_sign_in_msg'), new_user_session_path))
  - poll_response = poll.response_for_respondent(respondent)
  - form_object = poll_response.persisted? ? [poll_response] : [poll, poll_response]
  - counts_by_option = poll.responses_and_counts
  - total_response_count = counts_by_option.values.sum
  - poll_form_id = "poll_#{poll.id}_response_form"
  = form_for form_object, html: {id: poll_form_id} do |f|
    - if current_user.nil?
      = hidden_field_tag :guest_guid, params[:guest_guid]
    = fields_for :respondent do |respondent_form|
      = respondent_form.hidden_field :name
      = respondent_form.hidden_field :email
    %ul.poll-options.list-group
      - counts_by_option.each do |option, count|
        - percentage = total_response_count.zero? ? 0 : (100.0 * count / total_response_count).round
        %li.poll-option.list-group-item
          %label.poll-option-choice
            = f.radio_button :poll_option_id, option.id, disabled: respondent.nil?, class: 'form-check-input mt-0 flex-shrink-0'
            %span.poll-option-text= option.choice
            %span.poll-option-count
              - if count > 0
                = count
          - if count > 0
            .poll-option-bar{role: 'progressbar', 'aria-valuenow': count, 'aria-valuemin': 0, 'aria-valuemax': total_response_count, 'aria-label': option.choice, style: "width: #{percentage}%"}
  - unless respondent.nil?
    .poll-actions
      - submit_label = poll_response.persisted? ? t('poll_response.form.update') : t('poll_response.form.create')
      = submit_tag submit_label, form: poll_form_id, class: 'btn btn-sm btn-secondary'
      - if poll_response.persisted?
        = button_to t('poll_response.form.destroy'), poll_response_path(poll_response, guest_guid: params[:guest_guid]), method: :delete, class: 'btn btn-sm btn-outline-danger', form_class: 'd-inline'
