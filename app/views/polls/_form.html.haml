- if f.object.errors.any?
  %div{class: "poll_error_explanation_#{f.object.id}"}
    %h2= t('poll.form.errors_msg', count: f.object.errors.count)
    %ul
      - f.object.errors.full_messages.each do |message|
        %li= message
= f.form_group layout: :inline, class: 'row', data: {controller: 'dynamic-list-record'} do
  = dynamic_list_record_hidden_fields(f)
  .input-group
    = f.text_field :question, floating: true
    = dynamic_list_record_delete_button

  .my-2.px-4
    = dynamic_list t('poll.form.add_option'), f, :responses, {partial: 'poll_responses/edit_example_response', layout: :inline}, class: 'btn btn-success' do
      = f.fields_for(:responses, scope: :example, layout: :inline) do |r|
        = render partial: 'poll_responses/edit_example_response', locals: {f: r}
